# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# El archivo .env NO se sube a GitHub.

# --- Base de datos ---
DB_NAME=medrecord
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena

# --- Correo (alertas y recuperación de contraseña) ---
# Si dejas EMAIL_HOST vacío, los correos NO se envían: aparecen en los logs
# de Docker (útil para probar). Para Gmail usa una "contraseña de aplicación".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MedRecord <tu_correo@gmail.com>

# Dirección del frontend que va en los enlaces de los correos
FRONTEND_URL=http://localhost:5173
